# All optional — the site builds and runs with none of these set.

# Canonical origin used by metadata, JSON-LD, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://tejavenkatkundem.com

# Classic GitHub token, no scopes required. Only lifts the API rate limit for
# the live GitHub section; unset means unauthenticated requests (60/hr per IP).
GITHUB_TOKEN=

# Set BOTH to have the contact form send email directly through Resend.
# With either missing, the form hands the message to the visitor's mail client.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=portfolio@yourdomain.com
